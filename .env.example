# ---------------------------------------------------------------------------
# Mmako Inc — environment variables
# Copy this file to `.env.local` for local development, and set the same
# variables in your Vercel project settings before deploying.
# ---------------------------------------------------------------------------

# Resend API key — create one at https://resend.com/api-keys
# Required for the /contact form to actually deliver email.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=info@mmakoinc.com

# The "from" address Resend sends as. This domain must be verified in Resend
# (https://resend.com/domains). Until it is, use onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL=website@mmakoinc.com

# Canonical site URL — used for sitemap.xml, robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://mmakoinc.com
